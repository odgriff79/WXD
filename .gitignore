# Large data files (downloaded, not tracked)
*.nc
*.grib
*.grib2

# Local secrets (VM connection, credentials - never commit)
.vm_config

# Note: data/*.json files ARE tracked (that's the whole point)
# Timestamped files: gfs_2025-12-27_0730Z.json
# Latest symlinks: gfs_latest.json
.claude/
