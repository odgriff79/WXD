# Python
venv/
__pycache__/
*.pyc
*.pyo

# IDE
.vscode/
.idea/

# OS
.DS_Store
Thumbs.db

# Logs (keep locally, don't push)
cron.log
cron_daily_summary.log
cron_sync.log
trackers/*/cron.log

# Alert state (hysteresis tracking, local to VM)
data/alert_state.json
trackers/*/data/alert_state.json

# Large data files (downloaded, not tracked)
*.nc
*.grib
*.grib2

# Local secrets (VM connection, credentials - never commit)
.vm_config

# Runtime data files (regenerated, don't need version control)
data/*.json
data/reply_listener_state.json
data/post_registry.json
data/tracker_state.json
trackers/*/data/*.json
ssw/*.json

# Logs
logs/*.log
ntfy_listener.log
.claude/
cron_replies.log

# Incoming files (screenshots, uploads)
incoming/

# Engagement state
engagement/data/*.json
